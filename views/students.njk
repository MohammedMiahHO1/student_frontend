<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Students</title>


</head>

<body>

    <h1>Students</h1>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Percentage</th>
                <th>Branch</th>
                <th>Subjects</th>
                <th>Grades</th>
            </tr>
        </thead>

        <tbody>

            {% for student in students %}

                <tr>
                    <td>
                        {{ student.rollNo }}
                    </td>

                    <td>
                         <a href="/students/{{ student.rollNo }}">
                                {{ student.name }}
                            </a>
                    </td>

                    <td>
                        {{ student.percentage }}%
                    </td>

                    <td>
                        {{ student.branch }}
                    </td>

                    <td>

                        {% if student.subjects.length > 0 %}

                            <ul class="subject-list">

                                {% for studentSubject in student.subjects %}

                                    <li>
                                        {{ studentSubject.subject.name }}


                                    </li>

                                {% endfor %}

                            </ul>

                        {% else %}

                            <span class="no-subjects">
                                No subjects
                            </span>

                        {% endif %}

                    </td>
                     <!-- Grades -->
                        <td>
                            {% if student.subjects.length > 0 %}

                                {% for studentSubject in student.subjects %}
                                    <div>
                                        {{ studentSubject.grade }}
                                    </div>
                                {% endfor %}

                            {% else %}
                                <span>-</span>
                            {% endif %}
                        </td>
                </tr>

            {% endfor %}

        </tbody>

    </table>
    <div class="add-student-container">
        <a href="/students/add" class="add-student-button">
            Add Student
        </a>
    </div>

</body>
</html>