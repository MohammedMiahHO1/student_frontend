<h1>Student Details</h1>

<p>
    <strong>ID:</strong>
    {{ student.rollNo }}
</p>

<p>
    <strong>Name:</strong>
    {{ student.name }}
</p>

<p>
    <strong>Branch:</strong>
    {{ student.branch }}
</p>

<p>
    <strong>Percentage:</strong>
    {{ student.percentage }}
</p>

<h2>Subjects</h2>

{% if student.subjects.length > 0 %}

    <table>
        <thead>
            <tr>
                <th>Subject</th>
                <th>Grade</th>
            </tr>
        </thead>

        <tbody>

            {% for studentSubject in student.subjects %}

                <tr>
                    <td>
                        {{ studentSubject.subject.name }}
                    </td>

                    <td>
                        {{ studentSubject.grade }}
                    </td>
                </tr>

            {% endfor %}

        </tbody>
    </table>

{% else %}

    <p>No subjects assigned.</p>

{% endif %}